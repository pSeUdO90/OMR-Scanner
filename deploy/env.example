# Copy to .env and set your domain.
# Production HTTPS example:
#   OMR_SITE=omr.yourschool.edu
#   ACME_EMAIL=you@yourschool.edu
# Caddy then issues a Let's Encrypt certificate automatically.
#
# Local / IP-only (HTTP):
#   OMR_SITE=:80

OMR_SITE=:80
ACME_EMAIL=admin@example.com
OMR_ALLOWED_HOSTS=*
